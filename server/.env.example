# Google Service Account key as base64-encoded JSON string
# To encode: base64 -w 0 service-account.json  (Linux/Mac)
# On Windows PowerShell: [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_KEY=<base64-encoded service account JSON>

# Google Sheets ID (from the URL of your spreadsheet)
GOOGLE_SHEET_ID=1N1POd9dhcXy3f-u_UZggNsLzE3hlObK4Y7JzFJQANQI

# Google Drive folder IDs containing audio files — separate folder per instrument
GOOGLE_DRIVE_FOLDER_ID=13-sArEtLQ6yaGCv9q5D_i3igCLcXuxxQ
GOOGLE_DRIVE_FOLDER_ID_ASER=1nwBAKufRBoudR0Ta0LQVk6I5ydZAsgdf

# Google Drive file IDs for each instrument's master data export (from the
# file's "Get link" URL: drive.google.com/file/d/<ID>/view). The server
# downloads these into CSV_PATH_EGRA/CSV_PATH_ASER on first load per process,
# and again whenever POST /api/instruments/:key/refresh-data is called — the
# local CSV files are just a cache, Drive is the source of truth.
GOOGLE_DRIVE_DATA_FILE_ID_EGRA=1MEkDufw_K4xue3oRHQmyFeSiKPYzeLe7
GOOGLE_DRIVE_DATA_FILE_ID_ASER=1vjEQTv6LaQGBTZ16M6Q32C7_5moFd2Tl

# JWT secret — change this to a long random string in production
JWT_SECRET=change-me-in-production

# Port to run the server on
PORT=3001

# Path to the CSV data file (relative to the server directory).
# CSV_PATH is kept as a fallback for CSV_PATH_EGRA so existing deployments
# don't need an urgent env change; new deployments should set both instrument
# paths explicitly.
CSV_PATH=../EGRA_EGMA_Combine_WIDE.csv
CSV_PATH_EGRA=../EGRA_EGMA_Combine_WIDE.csv
CSV_PATH_ASER=../ASER_ICT_Endline_FINAL_WIDE.csv

# USERS: JSON array of user objects with bcrypt password hashes
# Generate a hash: node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(h=>console.log(h))"
# Example below uses placeholder hashes — replace with real bcrypt hashes before deploying
USERS=[{"username":"mpatel","passwordHash":"$2a$10$placeholder"},{"username":"ahwaz","passwordHash":"$2a$10$placeholder"}]
